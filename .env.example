# Server
API_PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Docker Compose only: host port the `web` (nginx) container is published on.
WEB_PORT=8080

# Postgres (used by docker-compose and by the API's DATABASE_URL)
DB_USER=exercise_tracker
DB_PASSWORD=exercise_tracker
DB_NAME=exercise_tracker
DB_PORT=5432
DATABASE_URL=postgres://exercise_tracker:exercise_tracker@localhost:5432/exercise_tracker

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# Google OAuth2 (optional — leave blank to disable the strategy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Facebook OAuth2 (optional — leave blank to disable the strategy)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback
